.env
.env.*
!.env.example
*.pfx
*.p12
*-recovery-key.txt
node_modules/
bin/
obj/
.local/
.DS_Store
Thumbs.db
.tools/
dist/
coverage/
TestResults/
*.user
*.key
*.pem
*.db
*.db-*
*.log
/apps/artifacts/wrangler.jsonc

# Private repository custody material is never part of public history.
/legacy sentry/
*.bundle
*.zip
*.7z
