# The complete, byte-verified snapshot is preserved in the Git LFS transfer ZIP.
# Keep the extracted review copy locally without duplicating it in Git history.
/legacy sentry/snapshot/

# Company-only feature implementation and local release material.
/modules/mining/
/private/
/native/*.exe
/native/oc-bootstrap
go.work.sum

