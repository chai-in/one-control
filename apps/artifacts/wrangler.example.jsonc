{
  "name": "one-control-artifacts",
  "account_id": "REPLACE_WITH_YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": "dist/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ARTIFACT_PUBLIC_HOST": "artifacts.example.com",
    "ARTIFACT_NATIVE_PACKAGES_ENABLED": "false"
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "one-control-artifacts"
    }
  ]
}
