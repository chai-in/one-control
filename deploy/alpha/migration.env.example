# Invalid until every REQUIRED value is replaced. Store actual inputs outside Git.
# Literal NAME=value only. No quotes, export, expansion or inline comments.
# The existing migration CLI requires full API configuration. It does not load this file.
# Execute migration separately, once, through the approved supervisor.
# Optional NODE_EXTRA_CA_CERTS must be an absolute CA bundle path supplied to Node.
# The checker validates that path only. It does not read the CA or prove TLS.
NODE_ENV=production
DEPLOYMENT_STAGE=poc
POC_DEVICE_LIMIT=5
HOST=0.0.0.0
PORT=4317
DATABASE_URL=postgresql://REQUIRED_MIGRATION_ROLE:REQUIRED_FRESH_MIGRATION_PASSWORD@REQUIRED_DB_HOST/REQUIRED_DB_NAME?sslmode=verify-full
OIDC_ISSUER=https://REQUIRED_EXACT_ISSUER
OIDC_AUDIENCE=REQUIRED_API_AUDIENCE
OPERATOR_SUBJECTS=REQUIRED_OPERATOR_SUBJECT
APPROVER_SUBJECTS=REQUIRED_APPROVER_SUBJECT
VIEWER_SUBJECTS=
RELEASE_PUBLIC_KEY_FILE=REQUIRED_ABSOLUTE_PUBLIC_KEY_PATH
ARTIFACT_HOSTS=REQUIRED_ARTIFACT_HOST
