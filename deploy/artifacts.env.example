# Run the artifact service on the server computer behind a TLS ingress.
# The ingress preserves Host and forwards only this host to the loopback port.
ARTIFACT_PUBLIC_HOST=artifacts.example.invalid
ARTIFACT_PORT=4319
ARTIFACT_ROOT=C:/ProgramData/OneControlArtifacts
# Same separately provisioned 32-byte binary key used by the control plane.
CREDENTIAL_ROOT=C:/ProgramData/OneControlSecrets
ARTIFACT_READ_KEY_FILE=C:/ProgramData/OneControlSecrets/artifact-read.key
