NODE_ENV=development
DEPLOYMENT_STAGE=poc
POC_DEVICE_LIMIT=5
HOST=127.0.0.1
PORT=4317
DATABASE_URL=local
# Run pnpm setup:local to generate three independent development credentials.
DEV_OPERATOR_TOKEN=
DEV_APPROVER_TOKEN=
DEV_VIEWER_TOKEN=
# Production only: use a PostgreSQL TLS URL with sslmode=verify-full.
# OIDC_ISSUER=https://identity.example.com
# OIDC_AUDIENCE=one-control-control-plane
# OPERATOR_SUBJECTS=subject-one
# APPROVER_SUBJECTS=subject-two
# VIEWER_SUBJECTS=subject-three
# RELEASE_PUBLIC_KEY_FILE=/run/secrets/release-public.pem
# ARTIFACT_HOSTS=updates.example.com
# CREDENTIAL_ROOT=/run/one-control-secrets
# NATIVE_AUTHORITY_CONFIG=/run/one-control-secrets/native-authority.json
# RECOVERY_ESCROW_KEYRING_FILE=/run/one-control-secrets/recovery-keyring.json
# FALCON_CLOUD=https://api.us-2.crowdstrike.com
# FALCON_CLIENT_ID=
# FALCON_CLIENT_SECRET=
# Optional independent Intel EMA backend; server-side secrets only.
# EMA_BASE_URL=https://ema.example.com
# EMA_USERNAME=
# EMA_PASSWORD=
